# Copy .env.example to .env, then fill in your own Azure OpenAI values.
# Do not commit .env.

# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource-name.openai.azure.com
AZURE_API_VERSION=2025-03-01-preview

# Azure deployment names, keyed by model
AZURE_DEPLOYMENT_SOL=your-gpt-56-sol-deployment-name
AZURE_DEPLOYMENT_ASTRA=your-gpt-6-astra-deployment-name
AZURE_DEPLOYMENT_LUNA=your-gpt-56-luna-deployment-name

# Pick a port nothing else holds (Docker often takes 4000, the Claude proxy 4010).
LITELLM_HOST=127.0.0.1
LITELLM_PORT=4020
LITELLM_MASTER_KEY=sk-local-codex-proxy

# Codex에 노출할 모델 별칭. 첫 번째(SOL)가 -m 없이 실행할 때의 기본 모델.
CODEX_MODEL_SOL_ALIAS=gpt-5.6-sol
CODEX_MODEL_ASTRA_ALIAS=gpt-6-astra
CODEX_MODEL_LUNA_ALIAS=gpt-5.6-luna
